[sub_resource type="VisualShader" id="VisualShader_kqxpy"]
code = "shader_type canvas_item;
render_mode blend_mix;




void fragment() {
// Input:3
	vec2 n_out3p0 = UV;


	vec4 n_out4p0;
// Texture2D:4
	n_out4p0 = texture(TEXTURE, n_out3p0);


	vec3 n_out2p0;
// ColorOp:2
	vec3 n_in2p1 = vec3(0.00000, 0.00000, 0.00000);
	{
		float base = vec3(n_out4p0.xyz).x;
		float blend = n_in2p1.x;
		if (base < 0.5) {
			n_out2p0.x = (base * (blend + 0.5));
		} else {
			n_out2p0.x = (1.0 - (1.0 - base) * (1.0 - (blend - 0.5)));
		}
	}
	{
		float base = vec3(n_out4p0.xyz).y;
		float blend = n_in2p1.y;
		if (base < 0.5) {
			n_out2p0.y = (base * (blend + 0.5));
		} else {
			n_out2p0.y = (1.0 - (1.0 - base) * (1.0 - (blend - 0.5)));
		}
	}
	{
		float base = vec3(n_out4p0.xyz).z;
		float blend = n_in2p1.z;
		if (base < 0.5) {
			n_out2p0.z = (base * (blend + 0.5));
		} else {
			n_out2p0.z = (1.0 - (1.0 - base) * (1.0 - (blend - 0.5)));
		}
	}


// Output:0
	COLOR.rgb = n_out2p0;


}
"
